    RAM_PROGRAM_SIZES[RAM_PROGRAM_AMOUNT] = size;
    RAM_PROGRAM_AMOUNT = RAM_PROGRAM_AMOUNT + 1;
    DISPADDR = RAM_PROGRAM_AMOUNT;
}

