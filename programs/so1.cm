int ROM_START;
int ROM_PROGRAM_AMOUNT;
int ROM_PROGRAM_POSITIONS[10];
int ROM_PROGRAM_SIZES[10];

int RAM_START;
int RAM_PROGRAM_AMOUNT;
int RAM_PROGRAM_POSITIONS[10];
int RAM_PROGRAM_SIZES[10];

int OPERATOR_LEN;
int ARGUMENT_LEN;
int OPERATOR_SHIFT;
int ARGUMENT_SHIFT;

int PC;
int ASSEMBLY;
int RELATIVE_START;
int STACK;
int RETURN_REGISTER;
int TRASH;
int ONE_CT;
int DISP;
int SWITCH;
int LCD;

int STACK_SPACING;

int power(int base, int exponent){
    int result;
    result = 1;
    while(exponent){
        result = result * base;
        exponent = exponent - 1;
    }
    return result;
}

void display(int number){
    int digits[20];
    int exit;
    int i;

    exit = 1;
    i = 0;
    while(exit){
        digits[i] = '0' + number - 10 * (number/10);
        number = number / 10;
        exit = number > 0;
        i = i + 1;
    }

    while(i){
        i = i - 1;
        LCDADDR = digits[i];
    }
}

void pause(int number){
    int input;
    display(number);
    input = SWICHADDR;
}

void stop(void){
    int input;
    input = SWICHADDR;
}

void show(int number){
    int opcode;
    int argument_a;
    int argument_b;
    int argument_c;

    opcode = number / (ARGUMENT_SHIFT * ARGUMENT_SHIFT * ARGUMENT_SHIFT);
    argument_a = (number * OPERATOR_SHIFT) / (ARGUMENT_SHIFT * ARGUMENT_SHIFT * OPERATOR_SHIFT);
    argument_b = (number * OPERATOR_SHIFT * ARGUMENT_SHIFT) / (ARGUMENT_SHIFT * ARGUMENT_SHIFT * OPERATOR_SHIFT);
    argument_c = (number * OPERATOR_SHIFT * ARGUMENT_SHIFT * ARGUMENT_SHIFT) / (ARGUMENT_SHIFT * ARGUMENT_SHIFT * OPERATOR_SHIFT);

    LCDADDR = 'o'; LCDADDR = 'p'; LCDADDR = ':'; LCDADDR = ' '; display(opcode); LCDADDR = ' ';
    LCDADDR = '('; display(argument_a); LCDADDR = ','; display(argument_b); LCDADDR = ','; display(argument_c); LCDADDR = ')';
}

int request(void){
    DISPADDR = 1818;
    return SWICHADDR > 0;
}   

void greeting(void){
    LCDADDR = 'S'; LCDADDR = 'O'; LCDADDR = 'L';
    LCDADDR = '.'; LCDADDR = 'S'; LCDADDR = 'O';
}

void found(void){
    int start;
    int end;
    int i;

    start = ROM_START + 1;
    ROM_PROGRAM_AMOUNT = MEM[ROM_START];
    end = start + 2 * ROM_PROGRAM_AMOUNT;

    LCDADDR = 255;
    LCDADDR = 'o'; LCDADDR = 'n'; LCDADDR = ':'; LCDADDR = ' '; display(ROM_START); LCDADDR = ' ';
    LCDADDR = 'f'; LCDADDR = 'o'; LCDADDR = 'u'; LCDADDR = 'n'; LCDADDR = 'd'; LCDADDR = ':'; LCDADDR = ' ';
    pause(ROM_PROGRAM_AMOUNT);
    
    i = 0;
    while(start < end){
        
        LCDADDR = 255;
        LCDADDR = 'i'; LCDADDR = 'd'; LCDADDR = 'x'; LCDADDR = ':'; LCDADDR = ' ';
        display(i);

        LCDADDR = ' '; LCDADDR = 'p'; LCDADDR = 'o'; LCDADDR = 's'; LCDADDR = ':'; LCDADDR = ' ';
        ROM_PROGRAM_POSITIONS[i] = MEM[start];
        display(MEM[start]);
        start = start + 1;
        
        ROM_PROGRAM_SIZES[i] = MEM[start];
        LCDADDR = ' '; LCDADDR = 'l'; LCDADDR = 'e'; LCDADDR = 'n'; LCDADDR = ':'; LCDADDR = ' ';
        pause(MEM[start]);
        start = start + 1;
        
        i = i + 1;
    }
}

void load(void){

    int who;
    int start;
    int end;
    int size;
    int offset;

    while(1){

        if(RAM_PROGRAM_AMOUNT > 10)
            return;
        
        LCDADDR = 255;
        LCDADDR = 'l'; LCDADDR = 'o'; LCDADDR = 'a'; LCDADDR = 'd'; LCDADDR = ':'; LCDADDR = ' ';
        who = SWICHADDR;
        display(who);
        
        if(who >= ROM_PROGRAM_AMOUNT)
            return;

        size = ROM_PROGRAM_SIZES[who];
        start = RAM_PROGRAM_POSITIONS[RAM_PROGRAM_AMOUNT];
        offset = ROM_PROGRAM_POSITIONS[who] - start;
        end = start + size;
        
        if(end > ROM_START)
            return;

        while(start < end){
            MEM[start] = MEM[start + offset];
            start = start + 1;
        }

        RAM_PROGRAM_POSITIONS[RAM_PROGRAM_AMOUNT + 1] = RAM_PROGRAM_AMOUNT[RAM_PROGRAM_AMOUNT] + STACK_SPACING + size;
        RAM_PROGRAM_SIZES[RAM_PROGRAM_AMOUNT] = size;
        RAM_PROGRAM_AMOUNT = RAM_PROGRAM_AMOUNT + 1;
        DISPADDR = RAM_PROGRAM_AMOUNT;
    }
}

void clear(void){
    LCDADDR = 255;
    LCDADDR = 'c'; LCDADDR = 'l'; LCDADDR = 'e'; LCDADDR = 'a'; LCDADDR = 'r'; LCDADDR = 'i'; LCDADDR = 'n'; LCDADDR = 'g';
    RAM_PROGRAM_AMOUNT  = 0;
    RAM_PROGRAM_POSITIONS[0] = RAM_START;
}

void bind(void){
    
    int i;
    i = 0;
    while(i < RAM_PROGRAM_AMOUNT){
        int end;
        int base;
        int start;
        int aux;

        base = RAM_PROGRAM_POSITIONS[i];
        LCDADDR = 255;
        LCDADDR = 'b'; LCDADDR = 'i'; LCDADDR = 'n'; LCDADDR = 'd'; LCDADDR = 'i'; LCDADDR = 'n'; LCDADDR = 'g'; LCDADDR = ':'; LCDADDR = ' '; pause(base); LCDADDR = ' ';
        
        MEM[base + PC]             = base + MEM[base + PC];
        MEM[base + ASSEMBLY]       = base + MEM[base + ASSEMBLY];
        MEM[base + RELATIVE_START] = base + MEM[base + RELATIVE_START];
        MEM[base + STACK]          = base + MEM[base + STACK];

        start = MEM[base + RELATIVE_START];
        end = MEM[base + ASSEMBLY];
        while(start < end){
            LCDADDR = 255;
            MEM[start] = MEM[start] + base;
            start = start + 1;
        }

        start = MEM[base + ASSEMBLY];
        end = MEM[base + STACK];
        while(start < end){
            int word;
            int lshift;
            int rshift;
            int bshift;
            int binded;
            int j;

            j = 0;
            binded = 0;
            bshift = 1;
            word = MEM[start];
            lshift = OPERATOR_SHIFT * ARGUMENT_SHIFT * ARGUMENT_SHIFT;
            rshift = lshift; 
            
            while(j < 3){
                int argument;
                argument = (word * lshift) / rshift;
                binded = binded + (argument + base * (argument != PC) * (argument != DISP) * (argument != LCD) * (argument != SWITCH)) * bshift;
                bshift = bshift * ARGUMENT_SHIFT; 
                lshift = lshift / ARGUMENT_SHIFT;
                j = j + 1;
            }

            binded = binded + (word / bshift) * bshift;
            MEM[start] = binded;
            start = start + 1;
        }
        
        i = i + 1;
    }
}

void done(void){
    LCDADDR = 255;
    LCDADDR = 'c'; LCDADDR = 'o'; LCDADDR = 'n'; LCDADDR = 's'; LCDADDR = 'g'; LCDADDR = 'u'; LCDADDR = 'i'; 
    LCDADDR = ' '; LCDADDR = 'd'; LCDADDR = 'n'; LCDADDR = 'v'; pause();
}

void execute(void){
    int entrypoint;
    int stack;
    int base;

    base = RAM_PROGRAM_POSITIONS[0];
    entrypoint = MEM[base + PC];
    stack      = MEM[base + STACK];

    LCDADDR = 255;
    LCDADDR = 'j'; LCDADDR = 'm'; LCDADDR = 'p'; LCDADDR = ':'; LCDADDR = ' '; display(entrypoint); LCDADDR = ' '; 
    LCDADDR = 'v'; LCDADDR = 'a'; LCDADDR = 'l'; LCDADDR = ':'; LCDADDR = ' '; pause(MEM[entrypoint]);
    MEM[stack]  = done;
    MEM[PC]     = entrypoint;
}

void main(void){
    int callbacks[10];
    int ontrue[10];
    int onfalse[10];
    int transitions[2];
    int state;

    ROM_START = 1792;            /* memory constants setting */
    RAM_START = 1024;
    RAM_PROGRAM_AMOUNT = 0;
    RAM_PROGRAM_POSITIONS[0] = RAM_START;
    
    OPERATOR_LEN = 4;           /* slicing constants setting */
    ARGUMENT_LEN = 11;          /* try power later */
    OPERATOR_SHIFT = 16;
    ARGUMENT_SHIFT = 2048;
    
    PC = 0;                     /* header constants setting */
    ASSEMBLY = 1;
    RELATIVE_START = 2;
    STACK = 3;
    RETURN_REGISTER = 4;
    TRASH = 5;
    ONE_CT = 6;
    DISP = 7;
    SWITCH = 8;
    LCD = 9;

    STACK_SPACING = 50;
    
    state = 0;                  /* state machine programming */
    transitions[0] = onfalse;
    transitions[1] = ontrue;

    callbacks[0]    = greeting; /* greet the user */
    ontrue[0]       = 1;
    onfalse[0]      = 1;

    callbacks[1]    = found;    /* print found files */
    ontrue[1]       = 2;        /* if yes choose loadout */
    onfalse[1]      = 1;        /* if no choose print files again */

    callbacks[2]    = load;     /* choose files to load */
    ontrue[2]       = 4;        /* if yes bind files */
    onfalse[2]      = 3;        /* if no clear ram */

    callbacks[3]    = clear;    /* clear ram (RAM_PROGRAM_AMOUNT = 0, RAM_PROGRAM_POSITIONS[0] = RAM_START) */
    ontrue[3]       = 2;        /* if yes load files again */
    onfalse[3]      = 1;        /* if no print found file  */

    callbacks[4]    = bind;     /* bind the program to it's current ram position */
    ontrue[4]       = 5;        /* if yes execute the binded programs */
    onfalse[4]      = 3;        /* if no clear ram */

    callbacks[5]    = execute;  /* execute the binded programs */
    ontrue[5]       = 5;        /* */
    onfalse[5]      = 5;        /* */

    while(1){
        int input;
        int callback;
        int event;
        
        callback = callbacks[state];
        callback();

        input = request();
        event = transitions[input];
        state = event[state];
    }
}
