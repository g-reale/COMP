void main(void){
    int delta;
    int wave;
    int period;

    SIN_AMPLITUDE = 65535;  /*2^16-1*/
    SIN_DOME = 8191;        /*2^13-1*/

    period = 1000;
    wave = 0;
    delta = SIN_AMPLITUDE / period;
    while(1){
        if(AUDIO_CAPACITY){
            AUDIO_SINK = wave;
            wave = wave + delta;
        }
    }
}
