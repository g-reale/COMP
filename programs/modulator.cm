void setupperiods(int periods[]){
    periods[0] = 24000;
    periods[1] = 48000;
}

void main(void){

    int TONE[64];
    int QUANTIZER;
    int PERIODS[2];
    int SYMBOL_TIME;

    LEVELS = 64;
    LENGTH = 0-1;
    QUANTIZER = LENGTH/LEVELS;
    SYMBOL_TIME = 10*48000;
    setupsin(TONE);
    setupperiods(PERIODS);

    while(1){
        int symbol;
        int period;
        int delta;
        int time;
        int wave;
        
        symbol = SWICHADDR;
        symbol = symbol * (symbol < 2);
        period = PERIODS[symbol];
        delta = LENGTH / period;
        time = SYMBOL_TIME;
        wave = 0;

        while(time){
            if(AUDIO_CAPACITY){
                AUDIO_SINK = TONE[wave/QUANTIZER];
                wave = wave + delta;
                time = time - 1;
            }
        }
    }
}
