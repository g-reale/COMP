void setupdeltas(int deltas[]){
    int CHANNEL_START;
    int CHANNEL_END;
    int CHANNEL_LENGTH;
    int i;

    CHANNEL_START = 2500;
    CHANNEL_END = 12500;
    CHANNEL_LENGTH = CHANNEL_END - CHANNEL_START;
   
    i = 0;
    while(i < ORDER){
        int frequency;
        frequency = (i * CHANNEL_LENGTH) / ORDER + CHANNEL_LENGTH / (2*ORDER) + CHANNEL_START;
        deltas[i] = (LENGTH/(SECOND * 2)) *  frequency;
        i = i + 1;
    }
}

int setupmsg(int symbols[]){
   
    int MESSAGE[8];
    int MSG_SIZE;
    int i;
    int j;
   
    MSG_SIZE = 8;
    MESSAGE[0] = 1;
    MESSAGE[1] = 35;
    MESSAGE[2] = 69;
    MESSAGE[3] = 103;
    MESSAGE[4] = 137;
    MESSAGE[5] = 171;
    MESSAGE[6] = 205;
    MESSAGE[7] = 239;

    i = 0;
    j = 0;
    while(i < MSG_SIZE){
        symbols[j]      = MESSAGE[i] / 16;
        symbols[j + 1]  = MESSAGE[i] - symbols[j] * 16;
        j = j + 2;
        i = i + 1;
    }

    return j;
}

void main(void){

    int TONE[64];
    int QUANTIZER;
    int DELTAS[16];
    int SYMBOL_TIME;
    int LEVELS;
    int SYMBOLS[64];
    int SYMBOL_AMOUNT;
    int index;
   
    ORDER = 16;
    SECOND = 48828;
    LENGTH = 0-1;

    LEVELS = 64;
    QUANTIZER = LENGTH/LEVELS;
    SYMBOL_TIME = 10 * SECOND;
   
    setupsin(TONE);
    setupdeltas(DELTAS);
    SYMBOL_AMOUNT = setupmsg(SYMBOLS);
    DISPADDR = SYMBOL_AMOUNT;

    index = 0;
    while(1){
        int symbol;
        int period;
        int delta;
        int time;
        int wave;
       
        symbol = SYMBOLS[index];
        delta = DELTAS[symbol];
        time = SYMBOL_TIME;
        index = index + 1;
        index = index * (index < SYMBOL_AMOUNT);
        wave = 0;

        while(time){
            if(AUDIO_CAPACITY){
                AUDIO_SINK = TONE[wave/QUANTIZER];
                wave = wave + delta;
                time = time - 1;
            }
        }

        time = SYMBOL_TIME;
        while(time){
            if(AUDIO_CAPACITY){
                AUDIO_SINK = 0;
                time = time - 1;
            }
        }
    }
}
