void main(void){

    int AMPLITUDE;
    int LENGTH;
    int LEVELS;
    int PERIOD;
    int ASTEP;
    int PSTEP;
    int LSTEP;
    int wave;

    AMPLITUDE = 65535;              /*codec max value*/
    LENGTH = 0-1;                   /*word max value*/
    LEVELS = 4;                     /*amount of desired levels*/
    PERIOD = 48000;                 /*period in samples*/

    ASTEP = AMPLITUDE / LEVELS;
    PSTEP = LENGTH / PERIOD;
    LSTEP = LENGTH / LEVELS;

    wave = 0;
    while(1){
        if(AUDIO_CAPACITY){
            AUDIO_SINK = 10000 * (wave / LSTEP);
            wave = wave + PSTEP;
        }
    }
}
