
int SIN_AMPLITUDE;
int SIN_HALF_PERIOD;
int SIN_PERIOD;
int SIN_A;
int SIN_B;
int SIN_C;
int SIN_D;
int SIN_E;

void setup_sin(int amplitude, int period){
    
    SIN_AMPLITUDE = amplitude;
    SIN_HALF_PERIOD = period;
    SIN_PERIOD = 2 * period;

    amplitude = amplitude * 2;
    SIN_A = 16 * amplitude * period;
    SIN_B = 0 - 16 * amplitude;
    SIN_C = 10 * period * period;
    SIN_D = 0 - 8 * period;
    SIN_E = 8;
}

int sin(int x){
    
    int xsq;
    x = x - SIN_PERIOD * (x/SIN_PERIOD); 
    
    if(SIN_HALF_PERIOD < x){
        x = x - SIN_HALF_PERIOD;
        xsq = x * x;
        return 0 - ((SIN_A * x + SIN_B * xsq) / (SIN_C + SIN_D * x + SIN_E * xsq));
    }
    else{
        xsq = x * x;
        return (SIN_A * x + SIN_B * xsq) / (SIN_C + SIN_D * x + SIN_E * xsq);    
    }
}

void main(void){

    int delta;
    int wave;
    int tone[512];

    setup_sin(128,32767);
    wave = 0;
    delta = 1;

    while(1){
        int i;

        i = 0;
        while(i < 512){
            tone[i] = sin(wave);
            wave = wave + 1;
            i = i + 1;
        }

        i = 0;
        while(i < 512){
            if(AUDIO_CAPACITY){
                AUDIO_SINK = tone[i];
                i = i + 1;
            }
        }
    }
}
