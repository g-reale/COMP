int LEVELS;
int AMPLITUDE;
int LENGTH;
int PERIOD;

void setupsin(int tone[]){
    tone[0] = 16384;
    tone[1] = 23047;
    tone[2] = 28559;
    tone[3] = 31965;
    tone[4] = 32677;
    tone[5] = 30572;
    tone[6] = 26013;
    tone[7] = 19790;
    tone[8] = 12977;
    tone[9] = 6754;
    tone[10] = 2195;
    tone[11] = 90;
    tone[12] = 802;
    tone[13] = 4208;
    tone[14] = 9720;
    tone[15] = 16383;
}

void setupperiods(int periods[]){
    periods[0] = 24000;
    periods[1] = 48000;
}

void main(void){

    int TONE[16];
    int QUANTIZER;
    int PERIODS[2];
    int SYMBOL_TIME;

    LEVELS = 16;
    QUANTIZER = LENGTH/LEVELS;
    SYMBOL_TIME = 10*48000;
    LENGTH = 0-1;

    setupsin(TONE);
    setupperiods(PERIODS);

    while(1){
        int symbol;
        int period;
        int delta;
        int time;
        int wave;
        
        symbol = SWICHADDR;
        symbol = symbol * (symbol < 2);
        period = PERIODS[symbol];
        delta = LENGTH / period;
        time = SYMBOL_TIME;
        wave = 0;

        while(time){
            if(AUDIO_CAPACITY){
                AUDIO_SINK = TONE[wave/QUANTIZER];
                wave = wave + delta;
                time = time - 1;
            }
        }
    }
}
